void SystemClock_Config(void);
static void MX_GPIO_Init(void);
static void MX_TIM2_Init(void);

int TIMER_CYCLE = 10;
int timer_counter = 0;
int timer_flag = 0;
int led_counter = 0;

const int MAX_LED_MATRIX = 8;
int index_led_matrix = 0;
int anim_offset = 0;
int matrix_counter = 0;
uint8_t matrix_buffer[8] = {
		0b00000000,
		0b11111100,
		0b00010010,
		0b00010001,
		0b00010001,
		0b00010010,
		0b11111100,
		0b00000000
};

uint8_t animation_buffer[12] = {

		0b00000000,
		0b00000000,
		0b11111111,
		0b11111111,
		0b00011011,
		0b00011011,
		0b00000000,
		0b00000000,

		0x00, 0x00, 0x00, 0x00,

};

void toggleLed(){
	HAL_GPIO_TogglePin(Led_red_GPIO_Port, Led_red_Pin);
}

void setTimer(int duration){
	timer_counter = duration / TIMER_CYCLE;
	timer_flag = 0;
}

void timerRun(){
	if (timer_counter > 0){
		timer_counter--;
		if (timer_counter == 0) timer_flag = 1;
	}
}

void HAL_TIM_PeriodElapsedCallback(TIM_HandleTypeDef *htim)
{
	timerRun();

	if (timer_flag == 1){
		led_counter++;
		if (led_counter >= 100) {
			toggleLed();
			led_counter = 0;
		}
	}

}

void clearMatrix(){
    HAL_GPIO_WritePin(ENM0_GPIO_Port, ENM0_Pin, GPIO_PIN_SET);
    HAL_GPIO_WritePin(ENM1_GPIO_Port, ENM1_Pin, GPIO_PIN_SET);
    HAL_GPIO_WritePin(ENM2_GPIO_Port, ENM2_Pin, GPIO_PIN_SET);
    HAL_GPIO_WritePin(ENM3_GPIO_Port, ENM3_Pin, GPIO_PIN_SET);
    HAL_GPIO_WritePin(ENM4_GPIO_Port, ENM4_Pin, GPIO_PIN_SET);
    HAL_GPIO_WritePin(ENM5_GPIO_Port, ENM5_Pin, GPIO_PIN_SET);
    HAL_GPIO_WritePin(ENM6_GPIO_Port, ENM6_Pin, GPIO_PIN_SET);
    HAL_GPIO_WritePin(ENM7_GPIO_Port, ENM7_Pin, GPIO_PIN_SET);
}

void updateLEDMatrix(int index){
	clearMatrix();

//	GPIOB->ODR = (GPIOB->ODR & 0x00FF) | (matrix_buffer[index] << 8);

	 uint8_t data = matrix_buffer[index];
	    for(int i = 0; i < 8; i++){
	        if(data & (1 << i)){
	            HAL_GPIO_WritePin(GPIOB, (1 << (8+i)), GPIO_PIN_RESET);
	        }else{
	            HAL_GPIO_WritePin(GPIOB, (1 << (8+i)), GPIO_PIN_SET);
	        }
	    }

    switch (index){
    	case 0: HAL_GPIO_WritePin(ENM0_GPIO_Port, ENM0_Pin, GPIO_PIN_RESET); break;
    	case 1: HAL_GPIO_WritePin(ENM1_GPIO_Port, ENM1_Pin, GPIO_PIN_RESET); break;
    	case 2: HAL_GPIO_WritePin(ENM2_GPIO_Port, ENM2_Pin, GPIO_PIN_RESET); break;
    	case 3: HAL_GPIO_WritePin(ENM3_GPIO_Port, ENM3_Pin, GPIO_PIN_RESET); break;
    	case 4: HAL_GPIO_WritePin(ENM4_GPIO_Port, ENM4_Pin, GPIO_PIN_RESET); break;
    	case 5: HAL_GPIO_WritePin(ENM5_GPIO_Port, ENM5_Pin, GPIO_PIN_RESET); break;
    	case 6: HAL_GPIO_WritePin(ENM6_GPIO_Port, ENM6_Pin, GPIO_PIN_RESET); break;
    	case 7: HAL_GPIO_WritePin(ENM7_GPIO_Port, ENM7_Pin, GPIO_PIN_RESET); break;
    	default: break;
    }
}

int anim_step = 0;

void updateAnimation(){
	for(int i = 0; i < 8; i++){
		matrix_buffer[i] = animation_buffer[(i + anim_offset) % 12];
	}
}

int main(void)
{
  HAL_Init();
  SystemClock_Config();
  MX_GPIO_Init();
  MX_TIM2_Init();

  HAL_TIM_Base_Start_IT(&htim2);

  setTimer(10);
  while (1)
  {
	  if (timer_flag == 1){
		  setTimer(10);

//		  ex10:
		  matrix_counter++;
		  if (matrix_counter >= MAX_LED_MATRIX){
		      anim_offset++;
		      if(anim_offset >= 12) anim_offset = 0;
		      updateAnimation();
			  matrix_counter = 0;
		  }


	      updateLEDMatrix(index_led_matrix);
	      index_led_matrix++;
	      if(index_led_matrix >= MAX_LED_MATRIX) index_led_matrix = 0;

	  }

  }
}

